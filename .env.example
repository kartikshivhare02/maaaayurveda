# Maa Ayurveda Environment Configuration Template
# Copy this file to .env.local for local development or set in Vercel / Netlify environment settings.

# ----------------------------------------------------
# 1. Supabase Database & Auth (Optional for demo/mock mode, required for live DB)
# ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------------------------------
# 2. Razorpay Payment Gateway (Optional for test/mock mode, required for live payments)
# ----------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ----------------------------------------------------
# 3. Application URL (Optional)
# ----------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.maaayurvedic.store
